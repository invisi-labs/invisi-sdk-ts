{
  "name": "@invisi-labs/protocol",
  "version": "1.3.0",
  "description": "Pure Invisi public ABIs, types, strict codecs, statements, signatures, capacities and gas references",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./note": {
      "types": "./dist/note.d.ts",
      "import": "./dist/note.js",
      "require": "./dist/note.cjs"
    },
    "./credit": {
      "types": "./dist/credit.d.ts",
      "import": "./dist/credit.js",
      "require": "./dist/credit.cjs"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js",
      "require": "./dist/provenance.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invisi-labs/primitives": "workspace:*",
    "ethers": "^6.17.0",
    "@noble/hashes": "1.8.0",
    "@noble/curves": "1.9.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisi-labs/invisi-sdk-ts.git",
    "directory": "packages/protocol"
  },
  "license": "Apache-2.0"
}
