{
  "name": "@invisi-labs/protocol",
  "version": "1.1.8",
  "description": "Deployment-scoped protocol statements, witnesses and contract operations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./note": {
      "types": "./dist/note.d.ts",
      "import": "./dist/note.js",
      "require": "./dist/note.cjs"
    },
    "./credit": {
      "types": "./dist/credit.d.ts",
      "import": "./dist/credit.js",
      "require": "./dist/credit.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invisi-labs/core": "workspace:*",
    "@invisi-labs/prover": "workspace:*",
    "ethers": "^6.17.0",
    "@invisi-labs/rpc": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisi-lab/invisi-sdk-ts.git",
    "directory": "packages/protocol"
  }
}
