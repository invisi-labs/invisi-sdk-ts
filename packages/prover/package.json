{
  "name": "@invisi-labs/prover",
  "version": "1.3.3",
  "description": "Local witnesses, authenticated proving artifacts and explicit native/WASM proof backends",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./aggregate": {
      "types": "./dist/aggregate.d.ts",
      "import": "./dist/aggregate.js",
      "require": "./dist/aggregate.cjs"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js"
    },
    "./provenance-witness": {
      "types": "./dist/provenance-witness.d.ts",
      "import": "./dist/provenance-witness.js",
      "require": "./dist/provenance-witness.cjs"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.wasm.config.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "sync:circuits": "node scripts/sync-circuits.mjs"
  },
  "dependencies": {
    "@invisi-labs/primitives": "workspace:1.3.3",
    "@noir-lang/noir_js": "1.0.0",
    "ethers": "^6.17.0",
    "@invisi-labs/protocol": "workspace:1.3.3",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "@aztec-foundation/bb.js": "6.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisi-labs/invisi-sdk-ts.git",
    "directory": "packages/prover"
  },
  "license": "Apache-2.0"
}
