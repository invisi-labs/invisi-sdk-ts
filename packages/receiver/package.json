    "@invisi-labs/contracts": "workspace:*",
    "@invisi-labs/deployments": "workspace:*",
    "@invisi-labs/ipp": "workspace:*",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
