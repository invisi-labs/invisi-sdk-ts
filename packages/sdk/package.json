{
  "name": "@invisi-labs/sdk",
  "version": "1.1.0",
  "description": "Invisi client wallet sessions, operations and infrastructure integration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ethers": {
      "types": "./dist/ethers.d.ts",
      "import": "./dist/ethers.js",
      "require": "./dist/ethers.cjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist/sqlite.cjs"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb.d.ts",
      "import": "./dist/indexeddb.js",
      "require": "./dist/indexeddb.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invisi-labs/core": "workspace:*",
    "@invisi-labs/protocol": "workspace:*",
    "@invisi-labs/prover": "workspace:*",
    "ethers": "^6.17.0",
    "@invisi-labs/rpc": "workspace:*",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist"
  ]
}
