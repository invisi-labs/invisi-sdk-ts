{
  "name": "@invisi-labs/sdk",
  "version": "1.2.3",
  "description": "Stateless Invisi transaction preparation, signing requests and protocol integration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ethers": {
      "types": "./dist/ethers.d.ts",
      "import": "./dist/ethers.js",
      "require": "./dist/ethers.cjs"
    },
    "./session-support": {
      "types": "./dist/session-support.d.ts",
      "import": "./dist/session-support.js",
      "require": "./dist/session-support.cjs"
    },
    "./note": {
      "types": "./dist/note.d.ts",
      "import": "./dist/note.js",
      "require": "./dist/note.cjs"
    },
    "./credit": {
      "types": "./dist/credit.d.ts",
      "import": "./dist/credit.js",
      "require": "./dist/credit.cjs"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js",
      "require": "./dist/provenance.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invisi-labs/primitives": "workspace:*",
    "@invisi-labs/protocol": "workspace:*",
    "@invisi-labs/prover": "workspace:*",
    "ethers": "^6.17.0",
    "@invisi-labs/rpc": "workspace:*",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.0.0",
    "@noble/curves": "1.9.1"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisi-lab/invisi-sdk-ts.git",
    "directory": "packages/sdk"
  }
}
