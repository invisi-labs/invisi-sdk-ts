{
  "name": "@invisi-labs/payment-router",
  "version": "1.3.5",
  "description": "Exact-output Uniswap V3 and 0x quotes, Invisi payment preparation and atomic Router transactions",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invisi-labs/sdk": "workspace:1.3.5",
    "@invisi-labs/protocol": "workspace:1.3.5",
    "@invisi-labs/primitives": "workspace:1.3.5",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisi-labs/invisi-sdk-ts.git",
    "directory": "packages/payment-router"
  },
  "license": "Apache-2.0"
}
