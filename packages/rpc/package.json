{
  "name": "@invisi-labs/rpc",
  "version": "1.3.2",
  "description": "Typed Protocol RPC, Broadcaster and Provenance clients, response validation and transport errors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js",
      "require": "./dist/provenance.cjs"
    },
    "./broadcaster": {
      "types": "./dist/broadcaster.d.ts",
      "import": "./dist/broadcaster.js",
      "require": "./dist/broadcaster.cjs"
    },
    "./trusted-provider": {
      "types": "./dist/trusted-provider.d.ts",
      "import": "./dist/trusted-provider.js",
      "require": "./dist/trusted-provider.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invisi-labs/primitives": "workspace:*",
    "ethers": "^6.17.0",
    "@invisi-labs/protocol": "workspace:*",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.0.0",
    "@noble/curves": "1.9.1"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisi-labs/invisi-sdk-ts.git",
    "directory": "packages/rpc"
  },
  "license": "Apache-2.0"
}
