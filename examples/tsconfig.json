{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "accounts/**"
  ]
}
