{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "BB_BINARY_PATH",
        "INVISI_TEST_WASM",
        "INVISI_PROVER_RESOURCE_DIR",
        "INVISI_PROVER_CACHE_DIR",
        "INVISI_PROVER_OFFLINE"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    "test-support/**/*.ts"
  ]
}
